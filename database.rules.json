{
  "rules": {
    "rooms": {
      "$roomId": {
        ".read": "auth != null && (data.child('meta/host').val() === auth.uid || data.child('meta/guest').val() === auth.uid)",

        "meta": {
          ".read": "auth != null",
          ".write": "auth != null && !data.exists() && newData.child('host').val() === auth.uid && !newData.child('guest').exists()",
          ".validate": "newData.hasChildren(['host', 'mode', 'seed', 'createdAt'])",
          "host": { ".validate": "newData.isString()" },
          "mode": { ".validate": "newData.isString() && newData.val().length <= 32" },
          "seed": { ".validate": "newData.isNumber()" },
          "createdAt": { ".validate": "newData.val() === now || data.exists()" },
          "guest": {
            ".write": "auth != null && !data.exists() && newData.val() === auth.uid && data.parent().child('host').val() !== auth.uid"
          },
          "status": {
            ".write": "auth != null && (data.parent().child('host').val() === auth.uid || data.parent().child('guest').val() === auth.uid)",
            ".validate": "newData.isString() && newData.val().length <= 16"
          },
          "$other": { ".validate": false }
        },

        "players": {
          "$uid": {
            ".write": "auth != null && auth.uid === $uid && (root.child('rooms').child($roomId).child('meta/host').val() === auth.uid || root.child('rooms').child($roomId).child('meta/guest').val() === auth.uid)"
          }
        },

        "moves": {
          "$uid": {
            "$seq": {
              ".write": "auth != null && auth.uid === $uid && !data.exists() && (root.child('rooms').child($roomId).child('meta/host').val() === auth.uid || root.child('rooms').child($roomId).child('meta/guest').val() === auth.uid)",
              ".validate": "newData.hasChild('type')"
            }
          }
        },

        "inbox": {
          "$uid": {
            "$msgId": {
              ".write": "auth != null && (root.child('rooms').child($roomId).child('meta/host').val() === auth.uid || root.child('rooms').child($roomId).child('meta/guest').val() === auth.uid) && ((auth.uid !== $uid && !data.exists()) || (auth.uid === $uid && !newData.exists()))",
              ".validate": "newData.hasChildren(['type', 'from'])"
            }
          }
        }
      }
    }
  }
}
